# DEEPSEEK_API_KEY: 用于 DeepSeek 大模型签文与比分三象预测。
# 请在本机 .env 或部署环境变量中配置真实值，不要提交真实密钥。
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# DEEPSEEK_MODEL: 默认使用 deepseek-chat；如需更强推理可按账号能力改为 deepseek-reasoner。
DEEPSEEK_MODEL="deepseek-chat"

# DEEPSEEK_BASE_URL: DeepSeek OpenAI 兼容接口地址，通常无需修改。
DEEPSEEK_BASE_URL="https://api.deepseek.com/chat/completions"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MySQL: 用于用户注册、登录会话和历史预测数据。
# 数据库名称按项目约定使用 mhxx。
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="mhxx"

# SESSION_SECRET: 用于服务端生成登录会话摘要。
# 请在正式使用时替换为随机长字符串，不要提交真实值。
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
